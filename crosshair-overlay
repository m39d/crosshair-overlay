#!/bin/sh
# Thin convenience wrapper: `crosshair-overlay` is the project's name and
# the command people intuitively try first, but the actual settings GUI
# entry point is crosshair-gui.py (named that way to stay distinct from
# crosshaird.py/crosshairctl.py). This just forwards to it so both names
# work, resolving symlinks so it works when installed via a symlinked
# ~/.local/bin entry too.
script_dir=$(dirname "$(readlink -f "$0")")
exec "$script_dir/crosshair-gui.py" "$@"
